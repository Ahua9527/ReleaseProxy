{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "release-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "preview_urls": false,
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  },
  "keep_vars": true
}
